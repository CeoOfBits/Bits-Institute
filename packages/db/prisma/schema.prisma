generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity & access ─────────────────────────

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatarUrl       String?
  status          AccountStatus @default(PENDING)
  emailVerifiedAt DateTime?
  twoFactorSecret String?
  twoFactorOn     Boolean       @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  roles            UserRole[]
  sessions         Session[]
  loginActivity    LoginActivity[]
  auditLogs        AuditLog[]
  studentProfile   StudentProfile?
  instructor       Instructor?
  notifications    Notification[]
  passwordResets   PasswordReset[]
  emailVerifies    EmailVerification[]

  @@index([status])
}

model Role {
  id          String           @id @default(uuid())
  key         String           @unique // SUPER_ADMIN, ADMIN, INSTRUCTOR, STUDENT, EDITOR
  name        String
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique // e.g. batch.create, student.transfer
  name  String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginActivity {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String // e.g. batch.create, student.transfer
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([action])
}

// ───────────────────────── People ─────────────────────────

model StudentProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  registrationNo String   @unique
  dateOfBirth    DateTime?
  city           String?
  xp             Int      @default(0)
  level          Int      @default(1)
  streakDays     Int      @default(0)
  lastActiveOn   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseEnrollments CourseEnrollment[]
  batchEnrollments  BatchEnrollment[]
  attendance        Attendance[]
  submissions       Submission[]
  attempts          QuizAttempt[]
  certificates      Certificate[]
  badges            StudentBadge[]
  xpEvents          XpEvent[]
  payments          Payment[]
}

model Instructor {
  id         String   @id @default(uuid())
  userId     String   @unique
  headline   String?
  bio        String?
  expertise  String[]
  experience Int? // years
  socialLinks Json?
  isPublic   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultFor    Course[]
  batchRoles    BatchInstructor[]
  liveClasses   LiveClass[]
  blogPosts     BlogPost[]
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id          String     @id @default(uuid())
  parentId    String?
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  courses     Course[]

  @@index([parentId])
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A permanent educational product. Delivered through Batches.
model Course {
  id                  String        @id @default(uuid())
  title               String
  slug                String        @unique
  shortDescription    String
  description         String
  categoryId          String
  imageUrl            String?
  durationHours       Int?
  durationLabel       String? // e.g. "3 months"
  level               CourseLevel   @default(BEGINNER)
  requirements        String[]
  outcomes            String[]
  priceMinor          Int           @default(0) // smallest currency unit
  currency            String        @default("PKR")
  enrollmentOpen      Boolean       @default(true)
  certificateEnabled  Boolean       @default(true)
  certificateCode     String? // used in certificate IDs, e.g. CCNA
  defaultInstructorId String?
  status              PublishStatus @default(DRAFT)
  seoTitle            String?
  seoDescription      String?
  seoKeywords         String[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  category          Category           @relation(fields: [categoryId], references: [id])
  defaultInstructor Instructor?        @relation(fields: [defaultInstructorId], references: [id])
  modules           CourseModule[]
  batches           Batch[]
  faqs              CourseFaq[]
  enrollments       CourseEnrollment[]
  certificates      Certificate[]
  coupons           Coupon[]

  @@index([categoryId])
  @@index([status, deletedAt])
}

model CourseModule {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  sortOrder Int      @default(0)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@index([courseId, sortOrder])
}

enum LessonType {
  VIDEO
  TEXT
  FILE
  QUIZ
  ASSIGNMENT
  LIVE
}

model Lesson {
  id            String       @id @default(uuid())
  moduleId      String
  title         String
  type          LessonType   @default(VIDEO)
  content       String?
  videoProvider String? // CLOUDFLARE_STREAM | MUX | YOUTUBE | SELF
  videoRef      String?
  durationMins  Int?
  isPreview     Boolean      @default(false)
  sortOrder     Int          @default(0)
  module        CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]

  @@index([moduleId, sortOrder])
}

model CourseFaq {
  id        String @id @default(uuid())
  courseId  String
  question  String
  answer    String
  sortOrder Int    @default(0)
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

// ───────────────────────── Batches ─────────────────────────

enum BatchStatus {
  UPCOMING
  ACTIVE
  FULL
  COMPLETED
  ARCHIVED
}

enum DeliveryMode {
  ONLINE
  OFFLINE
  HYBRID
}

/// A specific delivery of a Course (e.g. "CCNA — Batch 004").
model Batch {
  id          String       @id @default(uuid())
  courseId    String
  code        String // "001"
  name        String // "CCNA — Batch 001"
  capacity    Int
  mode        DeliveryMode @default(ONLINE)
  location    String?
  scheduleNote String? // "Mon/Wed/Fri 7–9 PM"
  shift       String? // Morning | Evening | Weekend
  startDate   DateTime
  endDate     DateTime?
  status      BatchStatus  @default(UPCOMING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  course      Course            @relation(fields: [courseId], references: [id])
  instructors BatchInstructor[]
  enrollments BatchEnrollment[]
  liveClasses LiveClass[]
  assignments Assignment[]
  quizzes     Quiz[]
  transfersFrom BatchTransfer[]  @relation("TransferFrom")
  transfersTo   BatchTransfer[]  @relation("TransferTo")

  @@unique([courseId, code])
  @@index([status, startDate])
}

enum InstructorRole {
  LEAD
  ASSISTANT
  GUEST
}

model BatchInstructor {
  id           String         @id @default(uuid())
  batchId      String
  instructorId String
  role         InstructorRole @default(LEAD)
  assignedAt   DateTime       @default(now())
  unassignedAt DateTime?
  batch        Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instructor   Instructor     @relation(fields: [instructorId], references: [id])

  @@index([batchId])
  @@index([instructorId])
}

// ───────────────────────── Enrollment history ─────────────────────────

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
  SUSPENDED
}

/// Student ↔ Course relationship. Never deleted; ended with a status.
model CourseEnrollment {
  id               String           @id @default(uuid())
  studentId        String
  courseId         String
  status           EnrollmentStatus @default(ACTIVE)
  startedAt        DateTime         @default(now())
  endedAt          DateTime?
  endReason        String?
  transferredFromId String? // previous CourseEnrollment on a course transfer
  createdAt        DateTime         @default(now())

  student     StudentProfile     @relation(fields: [studentId], references: [id])
  course      Course             @relation(fields: [courseId], references: [id])
  transferredFrom CourseEnrollment? @relation("CourseTransfer", fields: [transferredFromId], references: [id])
  transferredTo   CourseEnrollment[] @relation("CourseTransfer")
  batchEnrollments BatchEnrollment[]
  payments    Payment[]

  @@index([studentId, status])
  @@index([courseId, status])
}

/// One period of a student's membership in a batch. A batch transfer closes
/// this row and opens a new one, so history is preserved.
model BatchEnrollment {
  id                 String           @id @default(uuid())
  studentId          String
  batchId            String
  courseEnrollmentId String
  status             EnrollmentStatus @default(ACTIVE)
  joinedAt           DateTime         @default(now())
  leftAt             DateTime?
  createdAt          DateTime         @default(now())

  student          StudentProfile   @relation(fields: [studentId], references: [id])
  batch            Batch            @relation(fields: [batchId], references: [id])
  courseEnrollment CourseEnrollment @relation(fields: [courseEnrollmentId], references: [id])
  transfersOut     BatchTransfer[]  @relation("TransferOut")
  transfersIn      BatchTransfer[]  @relation("TransferIn")

  @@index([batchId, status])
  @@index([studentId, status])
}

model BatchTransfer {
  id               String   @id @default(uuid())
  studentId        String
  fromBatchId      String
  toBatchId        String
  fromEnrollmentId String
  toEnrollmentId   String
  reason           String?
  performedById    String
  transferredAt    DateTime @default(now())

  fromBatch      Batch           @relation("TransferFrom", fields: [fromBatchId], references: [id])
  toBatch        Batch           @relation("TransferTo", fields: [toBatchId], references: [id])
  fromEnrollment BatchEnrollment @relation("TransferOut", fields: [fromEnrollmentId], references: [id])
  toEnrollment   BatchEnrollment @relation("TransferIn", fields: [toEnrollmentId], references: [id])

  @@index([studentId])
  @@index([fromBatchId])
  @@index([toBatchId])
}

// ───────────────────────── Learning ─────────────────────────

model LessonProgress {
  id          String         @id @default(uuid())
  lessonId    String
  studentId   String
  completedAt DateTime?
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId])
}

model LiveClass {
  id           String    @id @default(uuid())
  batchId      String
  instructorId String
  topic        String
  startsAt     DateTime
  endsAt       DateTime
  provider     String? // ZOOM | LIVEKIT | LINK
  meetingUrl   String?
  recordingUrl String?
  createdAt    DateTime  @default(now())
  batch        Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  attendance   Attendance[]

  @@index([batchId, startsAt])
  @@index([instructorId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id          String           @id @default(uuid())
  liveClassId String
  studentId   String
  status      AttendanceStatus
  markedById  String?
  markedAt    DateTime         @default(now())
  liveClass   LiveClass        @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  student     StudentProfile   @relation(fields: [studentId], references: [id])

  @@unique([liveClassId, studentId])
  @@index([studentId])
}

model Assignment {
  id          String   @id @default(uuid())
  batchId     String
  title       String
  description String
  attachments Json?
  maxMarks    Int      @default(100)
  dueAt       DateTime
  createdAt   DateTime @default(now())
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([batchId, dueAt])
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RESUBMISSION_REQUESTED
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  text         String?
  links        String[]
  files        Json?
  status       SubmissionStatus @default(SUBMITTED)
  marks        Int?
  feedback     String?
  gradedById   String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile   @relation(fields: [studentId], references: [id])

  @@index([assignmentId])
  @@index([studentId])
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  SHORT_ANSWER
}

model Quiz {
  id               String    @id @default(uuid())
  batchId          String
  title            String
  durationMins     Int?
  passingPercent   Int       @default(50)
  maxAttempts      Int       @default(1)
  shuffleQuestions Boolean   @default(false)
  shuffleOptions   Boolean   @default(false)
  showResults      Boolean   @default(true)
  showCorrect      Boolean   @default(false)
  opensAt          DateTime?
  closesAt         DateTime?
  createdAt        DateTime  @default(now())
  batch            Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  questions        Question[]
  attempts         QuizAttempt[]

  @@index([batchId])
}

model Question {
  id          String       @id @default(uuid())
  quizId      String
  type        QuestionType
  prompt      String
  options     Json? // [{id,text,correct}]
  answerText  String? // for SHORT_ANSWER
  marks       Int          @default(1)
  sortOrder   Int          @default(0)
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@index([quizId, sortOrder])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId      String
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int?
  maxScore    Int?
  passed      Boolean?
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id])
  answers     QuizAnswer[]

  @@index([quizId, studentId])
}

model QuizAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  questionId String
  response   Json
  isCorrect  Boolean?
  awarded    Int?
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

// ───────────────────────── Certificates & gamification ─────────────────────────

enum CertificateStatus {
  VALID
  REVOKED
}

model Certificate {
  id         String            @id @default(uuid())
  code       String            @unique // BITS-CCNA-2026-00482
  studentId  String
  courseId   String
  batchId    String?
  grade      String?
  status     CertificateStatus @default(VALID)
  issuedAt   DateTime          @default(now())
  revokedAt  DateTime?
  revokeReason String?
  student    StudentProfile    @relation(fields: [studentId], references: [id])
  course     Course            @relation(fields: [courseId], references: [id])

  @@index([studentId])
  @@index([courseId])
}

model Badge {
  id          String         @id @default(uuid())
  key         String         @unique
  name        String
  description String
  iconUrl     String?
  holders     StudentBadge[]
}

model StudentBadge {
  studentId String
  badgeId   String
  earnedAt  DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge     Badge          @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([studentId, badgeId])
}

model XpEvent {
  id        String         @id @default(uuid())
  studentId String
  points    Int
  reason    String
  createdAt DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

// ───────────────────────── Notifications ─────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ───────────────────────── Payments ─────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                 String           @id @default(uuid())
  studentId          String
  courseEnrollmentId String?
  amountMinor        Int
  currency           String           @default("PKR")
  provider           String // BANK_TRANSFER | STRIPE | EASYPAISA | JAZZCASH ...
  providerRef        String?
  status             PaymentStatus    @default(PENDING)
  refundedMinor      Int              @default(0)
  invoiceNo          String?          @unique
  paidAt             DateTime?
  createdAt          DateTime         @default(now())
  student            StudentProfile   @relation(fields: [studentId], references: [id])
  courseEnrollment   CourseEnrollment? @relation(fields: [courseEnrollmentId], references: [id])

  @@index([studentId])
  @@index([status])
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  percentOff  Int?
  amountOffMinor Int?
  courseId    String?
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  course      Course?   @relation(fields: [courseId], references: [id])
}

// ───────────────────────── CMS ─────────────────────────

model BlogCategory {
  id    String     @id @default(uuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model Tag {
  id    String        @id @default(uuid())
  name  String
  slug  String        @unique
  posts BlogPostTag[]
}

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
}

model BlogPost {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  excerpt        String?
  content        Json // rich-text document (blocks)
  featuredImage  String?
  categoryId     String
  authorId       String?
  featured       Boolean      @default(false)
  status         BlogStatus   @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?
  metaDescription String?
  canonicalUrl   String?
  ogImage        String?
  schemaData     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  category       BlogCategory @relation(fields: [categoryId], references: [id])
  author         Instructor?  @relation(fields: [authorId], references: [id])
  tags           BlogPostTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Page {
  id        String        @id @default(uuid())
  slug      String        @unique
  title     String
  content   Json
  status    PublishStatus @default(DRAFT)
  seoTitle  String?
  seoDescription String?
  updatedAt DateTime      @updatedAt
}

model Testimonial {
  id        String  @id @default(uuid())
  name      String
  role      String?
  quote     String
  photoUrl  String?
  published Boolean @default(true)
  sortOrder Int     @default(0)
}

model Event {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  imageUrl    String?
  published   Boolean  @default(false)
}

model Faq {
  id        String  @id @default(uuid())
  question  String
  answer    String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AdSlot {
  id        String  @id @default(uuid())
  placement String  @unique // HEADER | BLOG | SIDEBAR | FOOTER
  html      String?
  enabled   Boolean @default(false)
}

model MediaAsset {
  id         String   @id @default(uuid())
  key        String   @unique // storage object key
  url        String
  mimeType   String
  sizeBytes  Int
  uploadedBy String?
  createdAt  DateTime @default(now())
}
